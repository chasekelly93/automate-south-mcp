PORT=8080
# Shared secret the n8n workflow must send in the x-scraper-secret header.
# Generate with: openssl rand -hex 32
SCRAPER_SECRET=pick_a_strong_random_secret_here
# Max ms to wait for a page to load before giving up on it
NAV_TIMEOUT_MS=20000
# Max characters of extracted text returned per page (keeps the downstream Claude call cheap)
MAX_TEXT_CHARS=6000
